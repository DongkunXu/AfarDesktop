          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータとのネットワーク接続が中断されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 컴퓨터와의 네트워크 연결이 끊겼습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion réseau avec l’ordinateur distant a été interrompue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione di rete con il computer remoto si è interrotta."
          }
