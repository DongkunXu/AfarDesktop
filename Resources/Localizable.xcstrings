          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer remoto non consente a questo account di collegarsi."
          }
        }
      }
    },
    "The remote computer ended the session after a period of inactivity." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长时间没有操作，远程电脑结束了会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
