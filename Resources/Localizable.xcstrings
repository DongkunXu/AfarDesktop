            "value" : "新しい言語は Afar Desktop の再起動後に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afar Desktop을 다시 시작하면 새 언어가 적용됩니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afar Desktop utilisera la nouvelle langue après un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afar Desktop userà la nuova lingua dopo il riavvio."
          }
        }
      }
    },
