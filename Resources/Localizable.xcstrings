    },
    "The session ended unexpectedly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话意外结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段意外結束。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
