    },
    "The remote computer asks for something Afar Desktop cannot do yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程电脑要求的功能 Afar Desktop 暂时还不支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端電腦要求的功能 Afar Desktop 尚不支援。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータが Afar Desktop でまだ対応していない機能を要求しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 컴퓨터가 Afar Desktop에서 아직 지원하지 않는 기능을 요구합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur distant demande quelque chose qu’Afar Desktop ne sait pas encore faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer remoto richiede qualcosa che Afar Desktop non sa ancora fare."
          }
        }
      }
    },
    "The remote computer did not accept the user name or password." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程电脑拒绝了这个用户名或密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端電腦不接受此使用者名稱或密碼。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータがユーザ名またはパスワードを受け付けませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 컴퓨터가 사용자 이름 또는 암호를 거부했습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur distant n’a pas accepté le nom d’utilisateur ou le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer remoto non ha accettato il nome utente o la password."
          }
        }
      }
    },
    "The remote computer did not answer. Check that it is on, that remote desktop is enabled and that the network allows the connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程电脑没有响应。请确认它已开机、开启了远程桌面，并且网络允许连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端電腦沒有回應。請確認它已開機、已啟用遠端桌面，而且網路允許連線。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータが応答しません。電源が入っていること、リモートデスクトップが有効なこと、ネットワークが接続を許可していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 컴퓨터가 응답하지 않습니다. 전원이 켜져 있는지, 원격 데스크톱이 활성화되어 있는지, 네트워크가 연결을 허용하는지 확인하세요."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur distant n’a pas répondu. Vérifiez qu’il est allumé, que le Bureau à distance est activé et que le réseau autorise la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer remoto non risponde. Verifica che sia acceso, che il desktop remoto sia attivo e che la rete consenta la connessione."
          }
        }
      }
    },
    "The remote computer does not allow this account to connect." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程电脑不允许这个账户连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端電腦不允許此帳號連線。"
          }
        },
        "ja" : {
          "stringUnit" : {
