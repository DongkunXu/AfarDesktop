# Copy to config/signing.env (ignored by git) to build with your own identity.
#
# Bundle identifier of your build. Saved connections, Keychain items and window positions
# belong to it, so keep it stable once you use the app.
BUNDLE_ID="io.github.afardesktop.AfarDesktop"

# Code signing identity: "-" signs ad hoc (fine for local use; macOS may ask again for
# Keychain access after each rebuild). A "Developer ID Application: ..." or
# "Apple Development: ..." identity keeps Keychain access across builds.
SIGN_IDENTITY="-"

# Keychain profile created with `xcrun notarytool store-credentials`, used by
# scripts/package-release.sh to notarize. Leave empty to skip notarization.
NOTARY_PROFILE=""
