+/*
+ * Decodes the Annex B bit stream of AVC420 / AVC444 frames with the system's (normally
+ * hardware) H.264 decoder. Each call carries one access unit and is decoded synchronously.
+ * The luma plane is handed to FreeRDP straight from the decoded image; chroma is copied into
+ * planar buffers when the decoder produces interleaved (bi-planar) output. Sample values are
+ * never converted, so FreeRDP's own YUV to RGB stage sees exactly what the stream contains.
+ */
+
+#include <freerdp/config.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <VideoToolbox/VideoToolbox.h>
+
+#include <winpr/assert.h>
+#include <freerdp/log.h>
+
+#include "h264.h"
+
+#define NAL_SPS 7
+#define NAL_PPS 8
+
+typedef struct
+{
+	VTDecompressionSessionRef session;
+	CMVideoFormatDescriptionRef format;
+
+	BYTE* sps;
+	size_t spsSize;
+	BYTE* pps;
+	size_t ppsSize;
+
+	/* Length-prefixed (AVCC) copy of the slices of the access unit being decoded. */
+	BYTE* sample;
+	size_t sampleCapacity;
+
+	/* The image whose planes FreeRDP currently reads; locked until the next frame. */
+	CVPixelBufferRef shown;
+	/* Set by the output callback during a decode call. */
+	CVPixelBufferRef decoded;
+	OSStatus decodeStatus;
+
+	/* Planar chroma for bi-planar output. */
+	BYTE* chroma[2];
+	size_t chromaSize;
+} H264_CONTEXT_VT;
+
+static void vt_output(void* refcon, WINPR_ATTR_UNUSED void* sourceFrameRefCon, OSStatus status,
+                      WINPR_ATTR_UNUSED VTDecodeInfoFlags flags, CVImageBufferRef imageBuffer,
+                      WINPR_ATTR_UNUSED CMTime presentationTime,
+                      WINPR_ATTR_UNUSED CMTime presentationDuration)
+{
+	H264_CONTEXT_VT* sys = refcon;
+	sys->decodeStatus = status;
+	if (status == noErr && imageBuffer)
+	{
+		if (sys->decoded)
+			CVPixelBufferRelease(sys->decoded);
+		sys->decoded = CVPixelBufferRetain(imageBuffer);
+	}
+}
+
+static void vt_release_shown(H264_CONTEXT_VT* sys)
+{
+	if (!sys->shown)
+		return;
+	CVPixelBufferUnlockBaseAddress(sys->shown, kCVPixelBufferLock_ReadOnly);
+	CVPixelBufferRelease(sys->shown);
+	sys->shown = NULL;
+}
+
+static void vt_destroy_session(H264_CONTEXT_VT* sys)
+{
+	if (sys->session)
+	{
+		VTDecompressionSessionWaitForAsynchronousFrames(sys->session);
+		VTDecompressionSessionInvalidate(sys->session);
+		CFRelease(sys->session);
+		sys->session = NULL;
+	}
+	if (sys->format)
+	{
+		CFRelease(sys->format);
+		sys->format = NULL;
+	}
+}
+
+static BOOL vt_store(BYTE** dst, size_t* dstSize, const BYTE* src, size_t size, BOOL* changed)
+{
+	if (*dst && *dstSize == size && memcmp(*dst, src, size) == 0)
+		return TRUE;
+	BYTE* copy = malloc(size);
+	if (!copy)
+		return FALSE;
+	memcpy(copy, src, size);
+	free(*dst);
+	*dst = copy;
+	*dstSize = size;
+	*changed = TRUE;
+	return TRUE;
+}
+
+static BOOL vt_create_session(H264_CONTEXT* h264, H264_CONTEXT_VT* sys)
+{
+	vt_destroy_session(sys);
+
+	const uint8_t* sets[2] = { sys->sps, sys->pps };
+	const size_t sizes[2] = { sys->spsSize, sys->ppsSize };
+	OSStatus status = CMVideoFormatDescriptionCreateFromH264ParameterSets(
+	    kCFAllocatorDefault, 2, sets, sizes, 4, &sys->format);
+	if (status != noErr)
+	{
+		WLog_Print(h264->log, WLOG_ERROR, "VideoToolbox: invalid parameter sets (%d)", (int)status);
+		return FALSE;
+	}
+
+	const void* specKeys[] = { kVTVideoDecoderSpecification_EnableHardwareAcceleratedVideoDecoder };
+	const void* specValues[] = { kCFBooleanTrue };
+	CFDictionaryRef spec =
+	    CFDictionaryCreate(kCFAllocatorDefault, specKeys, specValues, 1,
+	                       &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+
+	const VTDecompressionOutputCallbackRecord callback = { vt_output, sys };
+	status = VTDecompressionSessionCreate(kCFAllocatorDefault, sys->format, spec, NULL, &callback,
+	                                      &sys->session);
+	if (spec)
+		CFRelease(spec);
+	if (status != noErr)
+	{
+		WLog_Print(h264->log, WLOG_ERROR, "VideoToolbox: cannot create a decoder (%d)",
+		           (int)status);
+		vt_destroy_session(sys);
+		return FALSE;
+	}
+	VTSessionSetProperty(sys->session, kVTDecompressionPropertyKey_RealTime, kCFBooleanTrue);
+	return TRUE;
+}
+
+static BOOL vt_append_nal(H264_CONTEXT_VT* sys, size_t* used, const BYTE* nal, size_t size)
+{
+	if (size > UINT32_MAX)
+		return FALSE;
+	if (*used + 4 + size > sys->sampleCapacity)
+	{
+		const size_t capacity = (*used + 4 + size) * 2;
+		BYTE* grown = realloc(sys->sample, capacity);
+		if (!grown)
+			return FALSE;
+		sys->sample = grown;
+		sys->sampleCapacity = capacity;
+	}
+	BYTE* p = sys->sample + *used;
+	p[0] = (BYTE)(size >> 24);
+	p[1] = (BYTE)(size >> 16);
+	p[2] = (BYTE)(size >> 8);
+	p[3] = (BYTE)size;
+	memcpy(p + 4, nal, size);
+	*used += 4 + size;
+	return TRUE;
+}
+
+/* Finds the next Annex B start code at or after `from`; returns `size` if there is none. */
+static size_t vt_next_start(const BYTE* data, size_t size, size_t from, size_t* codeLength)
+{
+	for (size_t i = from; i + 3 <= size; i++)
+	{
+		if (data[i] == 0 && data[i + 1] == 0)
+		{
+			if (data[i + 2] == 1)
+			{
+				*codeLength = 3;
+				return i;
+			}
+			if (i + 4 <= size && data[i + 2] == 0 && data[i + 3] == 1)
+			{
+				*codeLength = 4;
+				return i;
+			}
+		}
+	}
+	*codeLength = 0;
+	return size;
+}
+
+/* Hands the decoded image to FreeRDP as three planes. */
+static BOOL vt_publish(H264_CONTEXT* h264, H264_CONTEXT_VT* sys, CVPixelBufferRef image)
+{
+	vt_release_shown(sys);
+	if (CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess)
+	{
+		CVPixelBufferRelease(image);
+		return FALSE;
+	}
+	sys->shown = image;
+
+	const size_t width = CVPixelBufferGetWidth(image);
+	const size_t height = CVPixelBufferGetHeight(image);
+	const size_t planes = CVPixelBufferGetPlaneCount(image);
+	if (width > UINT32_MAX || height > UINT32_MAX)
+		return FALSE;
+
+	h264->pYUVData[0] = CVPixelBufferGetBaseAddressOfPlane(image, 0);
+	h264->iStride[0] = (UINT32)CVPixelBufferGetBytesPerRowOfPlane(image, 0);
+
+	if (planes == 3)
+	{
+		for (size_t x = 1; x < 3; x++)
+		{
+			h264->pYUVData[x] = CVPixelBufferGetBaseAddressOfPlane(image, x);
+			h264->iStride[x] = (UINT32)CVPixelBufferGetBytesPerRowOfPlane(image, x);
+		}
+	}
+	else if (planes == 2)
+	{
+		/* Interleaved CbCr: split into two planes. */
+		const size_t chromaWidth = (width + 1) / 2;
+		const size_t chromaHeight = (height + 1) / 2;
+		const size_t stride = (chromaWidth + 15) & ~(size_t)15;
+		const size_t needed = stride * (chromaHeight + 1);
+		if (needed > sys->chromaSize)
+		{
+			for (size_t x = 0; x < 2; x++)
+			{
+				free(sys->chroma[x]);
+				sys->chroma[x] = calloc(1, needed);
+				if (!sys->chroma[x])
+				{
+					sys->chromaSize = 0;
+					return FALSE;
+				}
+			}
+			sys->chromaSize = needed;
+		}
+		const BYTE* src = CVPixelBufferGetBaseAddressOfPlane(image, 1);
+		const size_t srcStride = CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+		for (size_t row = 0; row < chromaHeight; row++)
+		{
+			const BYTE* in = src + row * srcStride;
+			BYTE* cb = sys->chroma[0] + row * stride;
+			BYTE* cr = sys->chroma[1] + row * stride;
+			for (size_t col = 0; col < chromaWidth; col++)
+			{
+				cb[col] = in[2 * col];
+				cr[col] = in[2 * col + 1];
+			}
+		}
+		h264->pYUVData[1] = sys->chroma[0];
+		h264->pYUVData[2] = sys->chroma[1];
+		h264->iStride[1] = h264->iStride[2] = (UINT32)stride;
+	}
+	else
+	{
+		WLog_Print(h264->log, WLOG_ERROR, "VideoToolbox: unexpected image with %zu planes", planes);
+		return FALSE;
+	}
+
+	h264->YUVWidth = (UINT32)width;
+	h264->YUVHeight = (UINT32)height;
+	return TRUE;
+}
+
+static int vt_decompress(H264_CONTEXT* WINPR_RESTRICT h264, const BYTE* WINPR_RESTRICT pSrcData,
+                         UINT32 SrcSize)
+{
+	WINPR_ASSERT(h264);
+	H264_CONTEXT_VT* sys = h264->pSystemData;
+	WINPR_ASSERT(sys);
+
+	BOOL parametersChanged = FALSE;
+	size_t used = 0;
+	size_t codeLength = 0;
+	size_t start = vt_next_start(pSrcData, SrcSize, 0, &codeLength);
+	while (start < SrcSize)
+	{
+		const size_t nal = start + codeLength;
+		size_t nextLength = 0;
+		size_t end = vt_next_start(pSrcData, SrcSize, nal, &nextLength);
+		const size_t next = end;
+		/* Trailing zero bytes belong to the next start code, not to this unit. */
+		while (end > nal && pSrcData[end - 1] == 0)
+			end--;
+		if (end > nal)
+		{
+			const BYTE type = pSrcData[nal] & 0x1F;
+			if (type == NAL_SPS)
+			{
+				if (!vt_store(&sys->sps, &sys->spsSize, &pSrcData[nal], end - nal,
+				              &parametersChanged))
+					return -1;
+			}
+			else if (type == NAL_PPS)
+			{
+				if (!vt_store(&sys->pps, &sys->ppsSize, &pSrcData[nal], end - nal,
+				              &parametersChanged))
+					return -1;
+			}
+			else if (!vt_append_nal(sys, &used, &pSrcData[nal], end - nal))
+				return -1;
+		}
+		start = next;
+		codeLength = nextLength;
+	}
+
+	if ((parametersChanged || !sys->session) && sys->sps && sys->pps)
+	{
+		if (!vt_create_session(h264, sys))
+			return -1;
+	}
+	if (!sys->session || used == 0)
+		return 0;
+
+	CMBlockBufferRef block = NULL;
+	OSStatus status = CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, sys->sample, used,
+	                                                     kCFAllocatorNull, NULL, 0, used, 0, &block);
+	if (status != noErr)
+		return -1;
+
+	CMSampleBufferRef sample = NULL;
+	const size_t sampleSize = used;
+	status = CMSampleBufferCreateReady(kCFAllocatorDefault, block, sys->format, 1, 0, NULL, 1,
+	                                   &sampleSize, &sample);
+	CFRelease(block);
+	if (status != noErr)
+		return -1;
+
+	sys->decodeStatus = noErr;
+	status = VTDecompressionSessionDecodeFrame(sys->session, sample, 0, NULL, NULL);
+	CFRelease(sample);
+
+	if (status == kVTInvalidSessionErr)
+	{
+		/* The decoder went away (for example after sleep); start again at the next key frame. */
+		vt_destroy_session(sys);
+		return 0;
+	}
+	if (status != noErr || sys->decodeStatus != noErr)
+	{
+		WLog_Print(h264->log, WLOG_WARN, "VideoToolbox: frame not decoded (%d/%d)", (int)status,
+		           (int)sys->decodeStatus);
+		return -1;
+	}
+
+	CVPixelBufferRef image = sys->decoded;
+	sys->decoded = NULL;
+	if (!image)
+		return 0;
+	return vt_publish(h264, sys, image) ? 1 : -1;
+}
+
+static void vt_uninit(H264_CONTEXT* h264)
+{
+	if (!h264)
+		return;
+	H264_CONTEXT_VT* sys = h264->pSystemData;
+	if (!sys)
+		return;
+	vt_destroy_session(sys);
+	vt_release_shown(sys);
+	if (sys->decoded)
+		CVPixelBufferRelease(sys->decoded);
+	free(sys->sps);
+	free(sys->pps);
+	free(sys->sample);
+	free(sys->chroma[0]);
+	free(sys->chroma[1]);
+	free(sys);
+	h264->pSystemData = NULL;
+	h264->numSystemData = 0;
+	for (size_t x = 0; x < 3; x++)
+		h264->pYUVData[x] = NULL;
+}
+
+static BOOL vt_init(H264_CONTEXT* h264)
+{
+	WINPR_ASSERT(h264);
+	if (h264->Compressor)
+		return FALSE; /* decoding only */
+
+	H264_CONTEXT_VT* sys = calloc(1, sizeof(H264_CONTEXT_VT));
+	if (!sys)
+		return FALSE;
+	h264->pSystemData = sys;
+	h264->numSystemData = 1;
+	return TRUE;
+}
+
+static int vt_compress(WINPR_ATTR_UNUSED H264_CONTEXT* WINPR_RESTRICT h264,
+                       WINPR_ATTR_UNUSED const BYTE** WINPR_RESTRICT pSrcYuv,
+                       WINPR_ATTR_UNUSED const UINT32* WINPR_RESTRICT pStride,
+                       WINPR_ATTR_UNUSED BYTE** WINPR_RESTRICT ppDstData,
+                       WINPR_ATTR_UNUSED UINT32* WINPR_RESTRICT pDstSize)
+{
+	return -1;
+}
+
+const H264_CONTEXT_SUBSYSTEM g_Subsystem_VideoToolbox = { "VideoToolbox", vt_init, vt_uninit,
+	                                                      vt_decompress, vt_compress };
